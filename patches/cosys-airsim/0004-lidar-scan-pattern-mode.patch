+// Pattern mode: every tick (UpdateFrequency) fires the shots due since the last tick (delta_time x points
+// per second, the fraction carried over), continuing through the pattern across ticks, all from the
+// current pose. A frame is published once PatternFrameRate's period has accumulated; it holds every shot
+// since the previous frame in firing order: shot i of n left at time_stamp - (n - 1 - i) / pps, so the
+// frame starts at time_stamp - n / pps and frame sizes vary by up to one tick's shots. Misses and hits
+// closer than MinRange are NaN points labelled "out_of_range". Points are in the sensor frame.
+bool UnrealLidarSensor::getPatternPointCloud(const msr::airlib::Pose& lidar_pose, const msr::airlib::Pose& vehicle_pose,
+	const msr::airlib::TTimeDelta delta_time, msr::airlib::vector<msr::airlib::real_T>& point_cloud, msr::airlib::vector<std::string>& groundtruth, msr::airlib::vector<msr::airlib::real_T>& point_cloud_final, msr::airlib::vector<std::string>& groundtruth_final)
+{
+	updatePose(lidar_pose, vehicle_pose);
+
+	// a long stall (start-up, pause) would otherwise fire a burst of hundreds of thousands of rays
+	const double dt = FMath::Min(double(delta_time), 2.0 * frame_period_);
+	if (dt <= 0)
+		return false;
+	frame_elapsed_ += dt;
+	shot_carry_ += dt * pattern_pps_;
+	const int32 n = int32(shot_carry_);
+	shot_carry_ -= n;
+
+	const msr::airlib::LidarSimpleParams& params = sensor_params_;
+	if (n > 0) {
+		const int32 base = int32(groundtruth.size());
+		point_cloud.resize(size_t(base + n) * 3);
+		groundtruth.resize(size_t(base + n));
+
+		// pattern shots and range noise, drawn here: gen_ / dist_ are not thread safe
+		const int32 pattern_size = int32(pattern_dirs_.size());
+		const double step = pattern_file_pps_ / pattern_pps_;  // < 1 never happens in practice; > 1 decimates
+		TArray<int32> shots;
+		shots.SetNumUninitialized(n);
+		for (int32 k = 0; k < n; ++k) {
+			shots[k] = int32(pattern_index_) % pattern_size;
+			pattern_index_ = FMath::Fmod(pattern_index_ + step, double(pattern_size));
+		}
+		TArray<float> noise;
+		if (params.generate_noise) {
+			noise.SetNumUninitialized(n);
+			for (int32 k = 0; k < n; ++k)
+				noise[k] = dist_(gen_);
+		}
+
+		const Vector3r start = VectorMath::add(lidar_pose, vehicle_pose).position;
+		const msr::airlib::Quaternionr sensor_to_world = VectorMath::coordOrientationAdd(lidar_pose.orientation, vehicle_pose.orientation);
+		auto to_unreal = [this](const Vector3r& p) {
+			return external_ ? ned_transform_->toFVector(p, 100, true) : ned_transform_->fromLocalNed(p);
+		};
+		const FVector trace_start = to_unreal(start);
+		const float nan = std::numeric_limits<float>::quiet_NaN();
+		const bool draw = sensor_params_.draw_debug_points;
+		TArray<FVector> draw_points;
+		if (draw)
+			draw_points.Init(FVector(nan), n);
+
+		ParallelFor(n, [&](int32 k) {
+			const Vector3r& dir = pattern_dirs_[shots[k]];
+			const Vector3r dir_world = VectorMath::rotateVector(dir, sensor_to_world, true);
+			FHitResult hit(ForceInit);
+			TArray<AActor*> ignore;
+			const bool is_hit = UAirBlueprintLib::GetObstacleAdv(actor_, trace_start, to_unreal(start + dir_world * params.range),
+				hit, ignore, ECC_Visibility, true, true);
+			const bool ignored = hit.PhysMaterial != nullptr &&
+				hit.PhysMaterial.Get()->GetFName().ToString().Contains("Lidar_Ignore_PhysicalMaterial");
+
+			const size_t i = size_t(base + k);
+			float range = hit.Distance / 100;
+			if (!is_hit || ignored || range < min_range_) {
+				point_cloud[3 * i] = point_cloud[3 * i + 1] = point_cloud[3 * i + 2] = nan;
+				groundtruth[i] = "out_of_range";
+				return;
+			}
+			if (params.generate_noise)
+				range += noise[k] * (1 + (range / params.range) * (params.noise_distance_scale - 1));
+			point_cloud[3 * i] = dir.x() * range;
+			point_cloud[3 * i + 1] = dir.y() * range;
+			point_cloud[3 * i + 2] = dir.z() * range;
+			const AActor* hit_actor = hit.GetActor();
+			groundtruth[i] = hit_actor != nullptr ? std::string(TCHAR_TO_UTF8(*hit_actor->GetName())) : std::string();
+			if (draw)
+				draw_points[k] = to_unreal(start + dir_world * range);
+		});
+
+		if (draw) {
+			// on the game thread, like the rotating lidar's points (see above); misses are NaN and skipped
+			TArray<FVector> hits;
+			for (const FVector& p : draw_points) {
+				if (!p.ContainsNaN())
+					hits.Add(p);
+			}
+			TWeakObjectPtr<UWorld> world(actor_->GetWorld());
+			const float life = 1.05f * float(frame_period_);
+			AsyncTask(ENamedThreads::GameThread, [world, hits = MoveTemp(hits), life]() {
+				if (UWorld* w = world.Get()) {
+					for (const FVector& p : hits)
+						UAirBlueprintLib::DrawPoint(w, p, 5, FColor::Green, false, life);
+				}
+			});
+		}
+	}
+
+	if (frame_elapsed_ + 1e-6 < frame_period_)
+		return false;
+	// keep the remainder: frames come at PatternFrameRate on average when firing faster than that
+	frame_elapsed_ = FMath::Fmod(frame_elapsed_ - frame_period_, frame_period_);
+	point_cloud_final = std::move(point_cloud);
+	groundtruth_final = std::move(groundtruth);
+	point_cloud.clear();
+	groundtruth.clear();
+	return true;
+}
+
 FVector UnrealLidarSensor::Vector3rToFVector(const Vector3r& input_vector) {
 	return FVector(input_vector.x(), input_vector.y(), -input_vector.z());
