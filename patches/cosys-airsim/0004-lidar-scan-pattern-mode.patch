+// Loads a scan pattern: "MID360PT", u32 version 1, u32 n_points, f32 points_per_second, u32 n_lasers,
+// then n_points x (f32 azimuth_deg, f32 elevation_deg) in emission order, little endian, in the Livox
+// sensor frame (x forward, y left, z up; azimuth positive to the left, elevation positive up).
+// A relative path is looked up in the project's Content and project directories.
+bool UnrealLidarSensor::loadPattern(const std::string& pattern_file)
+{
+	const FString file(UTF8_TO_TCHAR(pattern_file.c_str()));
+	TArray<FString> candidates;
+	if (FPaths::IsRelative(file)) {
+		candidates.Add(FPaths::Combine(FPaths::ProjectContentDir(), file));
+		candidates.Add(FPaths::Combine(FPaths::ProjectDir(), file));
+	}
+	candidates.Add(file);
+
+	TArray<uint8> data;
+	FString used;
+	for (const FString& c : candidates) {
+		if (FFileHelper::LoadFileToArray(data, *FPaths::ConvertRelativePathToFull(c))) {
+			used = FPaths::ConvertRelativePathToFull(c);
+			break;
+		}
+	}
+	constexpr int32 header_size = 24;
+	if (data.Num() < header_size || FMemory::Memcmp(data.GetData(), "MID360PT", 8) != 0) {
+		UE_LOG(LogTemp, Error, TEXT("Lidar pattern %s: missing or not a MID360PT file"), *file);
+		return false;
+	}
+	uint32 version, n_points, n_lasers;
+	float pps;
+	FMemory::Memcpy(&version, data.GetData() + 8, 4);
+	FMemory::Memcpy(&n_points, data.GetData() + 12, 4);
+	FMemory::Memcpy(&pps, data.GetData() + 16, 4);
+	FMemory::Memcpy(&n_lasers, data.GetData() + 20, 4);
+	if (version != 1 || n_points == 0 || pps <= 0 || data.Num() != header_size + int64(n_points) * 8) {
+		UE_LOG(LogTemp, Error, TEXT("Lidar pattern %s: bad header (version %u, %u points, %.0f/s, %d bytes)"),
+			*used, version, n_points, pps, data.Num());
+		return false;
+	}
+
+	pattern_dirs_.resize(n_points);
+	const float* angles = reinterpret_cast<const float*>(data.GetData() + header_size);
+	for (uint32 i = 0; i < n_points; ++i) {
+		const float az = FMath::DegreesToRadians(angles[2 * i]);
+		const float el = FMath::DegreesToRadians(angles[2 * i + 1]);
+		// Livox (y left, z up) -> AirSim sensor frame (y right, z down)
+		pattern_dirs_[i] = Vector3r(FMath::Cos(el) * FMath::Cos(az), -FMath::Cos(el) * FMath::Sin(az), -FMath::Sin(el));
+	}
+	pattern_file_pps_ = pps;
+	UE_LOG(LogTemp, Display, TEXT("Lidar pattern %s: %u shots, %.0f/s, %u lasers"), *used, n_points, pps, n_lasers);
+	return true;
 }
 
