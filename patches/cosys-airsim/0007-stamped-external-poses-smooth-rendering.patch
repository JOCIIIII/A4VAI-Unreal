+MultirotorPawnSimApi::Pose MultirotorPawnSimApi::getPose() const
+{
+    //the pawn is drawn behind a stamped stream: report the newest pose, as the physics body (sensors) has it
+    if (hasPoseStream()) {
+        multirotor_physics_body_->lock();
+        const Pose pose = multirotor_physics_body_->getPose();
+        multirotor_physics_body_->unlock();
+        return pose;
+    }
+    return PawnSimApi::getPose();
+}
+
 void MultirotorPawnSimApi::setPose(const Pose& pose, bool ignore_collision)
+{
+    {
+        std::lock_guard<std::mutex> lock(pose_samples_mutex_);
+        pose_samples_.clear(); //an unstamped pose (e.g. a teleport through the API) ends a stamped stream
+    }
+    applyPose(pose, ignore_collision);
+}
+
+void MultirotorPawnSimApi::setPoseStamped(const Pose& pose, double stamp, bool ignore_collision)
+{
+    applyPose(pose, ignore_collision);
+    if (render_delay_ <= 0)
+        return;
+    std::lock_guard<std::mutex> lock(pose_samples_mutex_);
+    if (!pose_samples_.empty()) {
+        const PoseSample& newest = pose_samples_.back();
+        if (stamp == newest.stamp) {
+            pose_samples_.back().pose = pose;
+            pose_sample_arrival_ = FPlatformTime::Seconds();
+            return;
+        }
+        //time going back (simulator reset) or a jump (teleport) starts a new stream
+        if (stamp < newest.stamp || (pose.position - newest.pose.position).norm() > 2.0f)
+            pose_samples_.clear();
+    }
+    pose_samples_.push_back({ stamp, pose });
+    while (pose_samples_.size() > 2 && pose_samples_.back().stamp - pose_samples_.front().stamp > 1.0)
+        pose_samples_.pop_front();
+    pose_sample_arrival_ = FPlatformTime::Seconds();
+}
+
+bool MultirotorPawnSimApi::hasPoseStream() const
+{
+    std::lock_guard<std::mutex> lock(pose_samples_mutex_);
+    return !pose_samples_.empty() && FPlatformTime::Seconds() - pose_sample_arrival_ < 0.5;
+}
+
+bool MultirotorPawnSimApi::getRenderPose(float dt, Pose& pose)
+{
+    std::lock_guard<std::mutex> lock(pose_samples_mutex_);
+    if (pose_samples_.empty() || FPlatformTime::Seconds() - pose_sample_arrival_ > 0.5) {
+        render_clock_valid_ = false; //no stamped stream (or it stopped): draw the newest pose
+        return false;
+    }
+    const double newest = pose_samples_.back().stamp;
+    if (!render_clock_valid_ || render_time_ < pose_samples_.front().stamp || newest - render_time_ > 0.5) {
+        //(re)start render_delay_ behind the newest sample
+        render_clock_valid_ = true;
+        render_time_ = FMath::Max(newest - render_delay_, pose_samples_.front().stamp);
+        render_prev_newest_ = newest;
+        render_source_rate_ = 1;
+        render_lead_ = render_delay_;
+    }
+    else if (dt > 0) {
+        //advance at the rate the stamps advance (smoothed over ~1 s), nudged to stay render_delay_ behind
+        render_source_rate_ += ((newest - render_prev_newest_) / dt - render_source_rate_) * FMath::Min(1.0, dt / 1.0);
+        render_prev_newest_ = newest;
+        render_lead_ += ((newest - render_time_) - render_lead_) * FMath::Min(1.0, dt / 0.5);
+        const double rate = FMath::Clamp(render_source_rate_ + (render_lead_ - render_delay_) * 2.0, 0.0, 2.0);
+        render_time_ = FMath::Min(render_time_ + rate * dt, newest);
+    }
+    //interpolate between the samples around render_time_ (stamps strictly increase)
+    size_t hi = pose_samples_.size() - 1;
+    while (hi > 0 && pose_samples_[hi - 1].stamp >= render_time_)
+        --hi;
+    if (hi == 0) {
+        pose = pose_samples_.front().pose;
+        return true;
+    }
+    const PoseSample& a = pose_samples_[hi - 1];
+    const PoseSample& b = pose_samples_[hi];
+    const float t = static_cast<float>((render_time_ - a.stamp) / (b.stamp - a.stamp));
+    pose.position = a.pose.position + (b.pose.position - a.pose.position) * t;
+    pose.orientation = a.pose.orientation.slerp(t, b.pose.orientation);
+    return true;
+}
